{
  "version": 1,
  "enabled": true,
  "access": {
    "channels": ["cli", "dingtalk", "feishu"],
    "audiences": ["owner"]
  },
  "settings": {
    "development_root": "~/workspace/development",
    "lookup_roots": ["~/github", "~/gitlab"],
    "clone_directory": "repositories",
    "default_policy": {
      "development_enabled": true,
      "base_branch": null,
      "validation_commands": [],
      "publication": "on_request",
      "merge": "explicit_current_head"
    }
  }
}
